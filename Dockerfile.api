FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src
COPY src/JaipurHub.Api/JaipurHub.Api.csproj src/JaipurHub.Api/
RUN dotnet restore src/JaipurHub.Api/JaipurHub.Api.csproj
COPY src/JaipurHub.Api/ src/JaipurHub.Api/
RUN dotnet publish src/JaipurHub.Api/JaipurHub.Api.csproj -c Release -o /out --no-restore
FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS runtime
WORKDIR /app
EXPOSE 8080
ENV ASPNETCORE_URLS=http://+:8080
COPY --from=build /out .
ENTRYPOINT ["dotnet","JaipurHub.Api.dll"]